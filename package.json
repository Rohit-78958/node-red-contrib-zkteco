{
  "name": "node-red-contrib-zkteco",
  "version": "1.0.0",
  "description": "A production-quality Node-RED contribution package for ZKTeco devices.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-html",
    "copy-html": "node scripts/copy-html.js",
    "test": "vitest run"
  },
  "keywords": [
    "node-red",
    "zkteco",
    "biometric",
    "attendance"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "node-red": {
    "nodes": {
      "zkteco-hello": "dist/nodes/zkteco-hello/zkteco-hello.js",
      "zkteco-config": "dist/nodes/zkteco-config/zkteco-config.js",
      "zkteco-connect": "dist/nodes/zkteco-connect/zkteco-connect.js",
      "zkteco-disconnect": "dist/nodes/zkteco-disconnect/zkteco-disconnect.js",
      "zkteco-operation": "dist/nodes/zkteco-operation/zkteco-operation.js"
    }
  },
  "author": "Rohit",
  "license": "MIT",
  "dependencies": {
    "node-zklib": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/node-red": "^1.3.5",
    "typescript": "^5.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
